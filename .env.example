# ==== GrowCraft 3D — Environment ====
# Salin jadi .env dan sesuaikan

# PostgreSQL
POSTGRES_USER=growcraft
POSTGRES_PASSWORD=growcraft
POSTGRES_DB=growcraft

# Backend API
DATABASE_URL=Host=localhost;Port=5432;Database=growcraft;Username=growcraft;Password=growcraft
JWT_KEY=ganti-dengan-secret-panjang-minimal-32-karakter!
ASPNETCORE_URLS=http://localhost:5000

# Redis
REDIS_URL=localhost:6379
