; Engine configuration file — Growmax (Godot 4)
; Migrasi dari web/index.html (Three.js) ke Godot 4.3, renderer GL Compatibility (target web).
config_version=5

[application]

config/name="Growmax"
config/description="Growmax — GrowCraft 3D. Farming sandbox voxel terinspirasi Growtopia & Minecraft."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Catalog="*res://scripts/data/catalog.gd"
GameState="*res://scripts/core/game_state.gd"
SaveSystem="*res://scripts/core/save_system.gd"
ChatSystem="*res://scripts/core/chat_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

